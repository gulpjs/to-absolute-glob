{
  "name": "@gulpjs/to-absolute-glob",
  "version": "4.0.0",
  "description": "Make a glob pattern absolute, ensuring that negative globs and patterns with trailing slashes are correctly handled.",
  "author": "Gulp Team <team@gulpjs.com> (https://gulpjs.com/)",
  "contributors": [
    "Blaine Bublitz <blaine.bublitz@gmail.com>"
  ],
  "funding": "https://github.com/sponsors/gulpjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulpjs/to-absolute-glob.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 22.15.0"
  },
  "main": "./index.js",
  "files": [
    "LICENSE",
    "index.js"
  ],
  "scripts": {
    "format-check": "prettier . --check",
    "format-write": "prettier . --write",
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=test/lcov.info \"test/*.js\""
  },
  "dependencies": {
    "is-negated-glob": "^1.0.0"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-gulp": "7.0.0",
    "prettier": "3.9.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "absolute",
    "file",
    "filepath",
    "glob",
    "negate",
    "negative",
    "path",
    "pattern",
    "resolve",
    "to"
  ]
}
